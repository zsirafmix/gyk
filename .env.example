# === Kötelező ===
POLLINATIONS_API_KEY=sk_ide_ird_a_kulcsot
GK_USERNAME=email@pelda.hu
GK_PASSWORD=jelszavad

# === Működés ===
# true = generál, de NEM posztol
DRY_RUN=true
# true = egy kör után kilép (teszteléshez)
ONCE=false

# === Pollinations ===
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_MODEL=openai

# === Kérdéskeresés ===
# Vesszővel elválasztott kategória-slugok (üres = kezdőlap + alapértelmezett)
# Példa: szamitastechnika,otthon,elektronikus-eszkozok
CATEGORIES=szamitastechnika,otthon,elektronikus-eszkozok
# Opcionális kulcsszavak (üres = nincs szűrés); vesszővel
KEYWORDS=
# Maximális válaszszám a kérdésen (ennél kevesebb/egyenlő → jelölt)
MAX_EXISTING_ANSWERS=2
# Csak a __valasz-nelkul listát használja (true/false)
ONLY_UNANSWERED=true

# === Rate limit ===
# Késleltetés két válasz között (mp), véletlenszerűen MIN–MAX között
DELAY_MIN_SEC=60
DELAY_MAX_SEC=120
# Óránkénti max válasz
MAX_ANSWERS_PER_HOUR=8
# Körök közötti várakozás, ha nincs új kérdés (mp)
POLL_INTERVAL_SEC=300

# === Böngésző ===
HEADLESS=true
# Munkamenet mentése (újralogin elkerülése)
STORAGE_STATE_PATH=storage/gk-session.json
ANSWERED_DB_PATH=data/answered.db

# === Egyéb ===
LOG_LEVEL=info
SITE_BASE_URL=https://www.gyakorikerdesek.hu

# Teszt: MOCK_AI=true esetén nem hív Pollinations API-t
MOCK_AI=false
