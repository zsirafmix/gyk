# === Gyakorikerdesek belépés (éles módhoz kötelező) ===
GK_USERNAME=email@pelda.hu
GK_PASSWORD=jelszavad

# === Pollinations (API kulcs NEM kötelező) ===
# Üresen hagyva a https://text.pollinations.ai végpontot használja
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://text.pollinations.ai
POLLINATIONS_MODEL=openai

# === Működés ===
# true = generál, de NEM posztol
DRY_RUN=true
# true = egy kör után kilép (teszteléshez)
ONCE=false
# Hány kérdésre válaszoljon egy futásban (0 = korlátlan). UI-ból is állítható.
MAX_QUESTIONS_PER_RUN=0

# === Kérdéskeresés ===
CATEGORIES=szamitastechnika,otthon,elektronikus-eszkozok
KEYWORDS=
MAX_EXISTING_ANSWERS=2
ONLY_UNANSWERED=true

# === Rate limit ===
DELAY_MIN_SEC=60
DELAY_MAX_SEC=120
MAX_ANSWERS_PER_HOUR=8
POLL_INTERVAL_SEC=300

# === Böngésző ===
HEADLESS=true
STORAGE_STATE_PATH=storage/gk-session.json
ANSWERED_DB_PATH=data/answered.db

# === Egyéb ===
LOG_LEVEL=info
SITE_BASE_URL=https://www.gyakorikerdesek.hu
MOCK_AI=false
# UI_PORT=3847
